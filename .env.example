# Copy this file to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by docker-compose.yml to create the database.
# 55432 avoids clashing with a PostgreSQL already installed on your machine.
POSTGRES_DB=medlink
POSTGRES_USER=medlink
POSTGRES_PASSWORD=medlink
POSTGRES_PORT=55432

# Used by Django (host port must match POSTGRES_PORT above)
DATABASE_URL=postgres://medlink:medlink@localhost:55432/medlink