# Copy this file to .env and adjust. Never commit .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Used by docker-compose.yml to create the database
POSTGRES_DB=medlink
POSTGRES_USER=medlink
POSTGRES_PASSWORD=medlink
POSTGRES_PORT=5432

# Used by Django (must match the values above)
DATABASE_URL=postgres://medlink:medlink@localhost:5432/medlink
